# =============================================================================
# OBRIGATORIAS — sem elas a aplicacao nao sobe
# (pydantic-settings levanta ValidationError no import de src.core.config)
# =============================================================================

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Base do Supabase usada para montar as URLs publicas de logo/banner.
SUPABASE_URL=https://your-project.supabase.co

# Segredos de assinatura. Trocar qualquer um invalida os tokens em circulacao.
# Gere um valor DIFERENTE para cada um:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CUSTOMER_AUTH_SECRET=change-this-customer-auth-secret
EMAIL_CODE_SECRET=change-this-email-code-secret
PASSWORD_RESET_SECRET=change-this-password-reset-secret

# Segredo dos tokens de lojista (painel e agente de impressao). Precisa ser
# DIFERENTE de CUSTOMER_AUTH_SECRET: sao dois publicos, e uma chave
# compartilhada faz um token forjado de um lado valer do outro. Valor igual ao
# do cliente derruba o boot (src/core/startup_checks.py).
# Trocar este valor desloga TODO lojista e para o agente de impressao que roda
# com token fixo no config.ini.
ADMIN_AUTH_SECRET=change-this-admin-auth-secret

# Usada pelo /chat e pela indexacao de embeddings.
OPENAI_API_KEY=

# =============================================================================
# OBRIGATORIAS PARA ENTREGA — validadas no startup (src/core/startup_checks.py)
# =============================================================================

# Com DELIVERY_ESTIMATE_PROVIDER=google_routes esta chave e obrigatoria.
# Se ficar vazia a API NAO sobe. Antes da Fase 0 ela subia normalmente e
# recusava todo pedido de entrega com reason=route_unavailable, sem erro.
# Precisa das APIs "Routes API" e "Geocoding API" habilitadas no projeto GCP.
GOOGLE_MAPS_ROUTES_API_KEY=

# =============================================================================
# OBRIGATORIAS NA PRATICA — a rota falha em runtime sem elas
# =============================================================================

# Sem RESEND_API_KEY o envio de codigo de verificacao e de recuperacao de
# senha falha (500 no cadastro; em forgot-password a falha e apenas logada,
# porque a resposta precisa ser generica).
RESEND_API_KEY=

# =============================================================================
# OPCIONAIS — tem default no codigo
# =============================================================================

APP_NAME=Pede Rápidex API

# production/prod desliga /docs, /redoc e /openapi.json.
APP_ENV=production
DEBUG=false

# Sobrepoe o gate de docs derivado do APP_ENV. Deixe vazio para seguir o APP_ENV.
ENABLE_API_DOCS=

SUPABASE_STORAGE_BUCKET=restaurant-assets

# Chave de servico do Supabase (Project Settings > API > service_role).
# Usada SOMENTE para gravar no Storage: e o que permite o painel enviar a
# foto do produto. Vazia = POST /admin/products/{id}/image responde 503; o
# resto do cardapio e as imagens ja enviadas continuam funcionando, porque
# o bucket e publico para leitura.
# Trate como segredo de producao: essa chave ignora RLS no banco inteiro.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_TIMEOUT_SECONDS=15

# Teto do arquivo aceito nas rotas de upload de imagem. Separado de
# MAX_REQUEST_BODY_BYTES porque uma foto de produto nao cabe em 256 KB e
# subir o limite geral abriria a mesma folga em toda rota de JSON.
MAX_IMAGE_UPLOAD_BYTES=3145728

CUSTOMER_ACCESS_TOKEN_MINUTES=10080
PASSWORD_RESET_TOKEN_MINUTES=15

# DEPRECIADA na Fase 1. Nenhuma rota usa mais a X-API-Key: as rotas /admin
# passaram a exigir JWT de lojista (POST /admin/auth/login). Pode ser
# removida do ambiente depois que a Fase 1 estiver no ar e o painel migrado.
INTERNAL_API_KEY=

# Validade do token do painel. 12h = um turno de trabalho.
ADMIN_ACCESS_TOKEN_MINUTES=720

EMAIL_FROM=Rapidex <no-reply@pederapidex.com>

MODEL_NAME=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small

GOOGLE_MAPS_ROUTES_BASE_URL=https://routes.googleapis.com
GOOGLE_MAPS_TIMEOUT_SECONDS=5
GOOGLE_MAPS_ROUTING_PREFERENCE=TRAFFIC_AWARE
DELIVERY_ESTIMATE_CACHE_TTL_SECONDS=600
DELIVERY_ESTIMATE_NEGATIVE_CACHE_TTL_SECONDS=120
DELIVERY_ESTIMATE_PROVIDER=google_routes

# Recomendada. Vazio = funciona, com dois efeitos colaterais:
#  - cache de estimativa de entrega so em memoria (perdido a cada deploy,
#    mais chamadas pagas ao Google Maps);
#  - contadores de rate limiting so em memoria, validos para 1 worker apenas.
# O startup emite warning quando esta vazia.
REDIS_URL=

# Teto do corpo da requisicao em bytes (413 acima disso).
MAX_REQUEST_BODY_BYTES=262144

# Janela em que reenviar a mesma Idempotency-Key devolve a resposta gravada
# em vez de criar um pedido novo.
IDEMPOTENCY_TTL_HOURS=24

# false = requisicao sem o header Idempotency-Key passa sem protecao, so com
# warning no log (escolhido para nao derrubar app antigo em campo).
# true = responde 400. Ligue quando confirmar que todo cliente envia o header.
IDEMPOTENCY_REQUIRED=false

RATE_LIMIT_ENABLED=true

# Cabecalho de onde sai o IP do cliente para o rate limiting.
# Atras do Traefik use x-real-ip (ele sobrescreve o valor enviado pelo
# cliente). Deixe vazio SOMENTE se a API for exposta sem proxy na frente —
# com proxy e sem cabecalho, todos os clientes caem no mesmo balde.
RATE_LIMIT_CLIENT_IP_HEADER=x-real-ip

# ---------------------------------------------------------------------------
# Pagamento (Fase 2)
# ---------------------------------------------------------------------------

# Gateway usado para cobrar pedidos com pagamento online.
#   sandbox     provider interno: cria a cobranca localmente e aceita webhook
#               assinado com PAYMENT_WEBHOOK_SECRET. Sem chamada externa e sem
#               dinheiro de verdade. E o padrao ate as credenciais chegarem.
#   mercadopago exige implementar as tres funcoes de
#               src/integrations/payment_gateway.py e preencher o token abaixo.
PAYMENT_PROVIDER=sandbox

# Segredo do HMAC do webhook do provider sandbox. Gere um valor aleatorio
# (ex.: python -c "import secrets; print(secrets.token_urlsafe(32))").
# Vazio = o webhook responde 503 e nenhum pedido online sai de "aguardando
# pagamento". O startup avisa.
PAYMENT_WEBHOOK_SECRET=

# Nao existe MERCADOPAGO_WEBHOOK_SECRET aqui: cada restaurante tem sua
# PROPRIA conta no Mercado Pago e a propria "Assinatura secreta" (painel do
# restaurante > Suas integracoes > sua aplicacao > Webhooks, depois de
# cadastrar a Notification URL). Esse segredo mora cifrado em
# restaurant_payment_credentials.webhook_secret_encrypted, cadastrado com
#   python scripts/register_restaurant_payment_credential.py --restaurant-slug ... --environment ...
# (pede o segredo em prompt oculto) ou, para atualizar so esse campo de uma
# credencial ja cadastrada,
#   python scripts/register_restaurant_payment_credential.py --restaurant-slug ... --environment ... --webhook-secret-only

# Qual credencial cadastrada por restaurante usar: "test" (padrao, para
# desenvolver sem mover dinheiro de verdade) ou "production". Trocar aqui
# nao mexe em codigo nem no banco — so exige que a credencial de producao
# ja tenha sido cadastrada com scripts/register_restaurant_payment_credential.py.
MERCADOPAGO_ENVIRONMENT=test

# Chave de cifra do access_token E do segredo do webhook guardados em
# restaurant_payment_credentials. So lida (e derruba o boot se vazia) com
# PAYMENT_PROVIDER=mercadopago.
# Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde-a como guardaria qualquer segredo de producao: perde-la torna toda
# credencial cadastrada ilegivel.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=

# Por quanto tempo a estimativa de entrega guardada pode ser reaproveitada na
# criacao do pedido (evita refazer geocode + rota no Google, que sao pagos).
# 15 min cobre o checkout e nao alcanca a proxima faixa de horario da filial.
DELIVERY_ESTIMATE_REUSE_TTL_SECONDS=900
